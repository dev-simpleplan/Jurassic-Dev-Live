<div class="top-bar">
    <div class="container">
        <div class="top-bar-in">
            <div class="tb-rating">
                <div class="tbr-icon">
                    <img class="icon" src="{{ section.settings.rating_image | img_url: 'master' }}" alt="{{ section.settings.rating_image }}">
                </div>
                <div class="tbr-text">{{ section.settings.rating_text }}</div>
            </div>
            {%- comment -%}
              When a special-occasion message is enabled, the shipping text and the
              special message auto-rotate as a ticker (see bindTopBarTicker below) instead
              of both being crammed into the bar at once. With it off, only the shipping
              line renders and no ticker JS/CSS engages — same as before this feature.
            {%- endcomment -%}
            {%- assign show_ticker = false -%}
            {%- if section.settings.special_message_enabled and section.settings.special_message_text != blank -%}
              {%- assign show_ticker = true -%}
            {%- endif -%}
            {%- comment -%}
              Multilingual: tbtext_prefix / tbtext_discount_prefix are free-text section
              settings, which Shopify does NOT auto-translate per store language — a single
              value entered once shows on every locale (this was the bug: German visitors
              saw English text). Only use the merchant's text when they've actually typed an
              override; otherwise fall back to the locale files (locales/en.default.json,
              fr.json, de.json, nl.json), which `| t` resolves in the page's own language
              automatically.
            {%- endcomment -%}
            {%- assign shipping_prefix = section.settings.tbtext_prefix -%}
            {%- if shipping_prefix == blank -%}
              {%- assign shipping_prefix = 'sections.top_bar.free_shipping_prefix' | t -%}
            {%- endif -%}
            {%- assign discount_prefix = section.settings.tbtext_discount_prefix -%}
            {%- if discount_prefix == blank -%}
              {%- assign discount_prefix = 'sections.top_bar.shipping_discount_suffix' | t -%}
            {%- endif -%}
            <div class="tb-text{% if show_ticker %} tb-text--ticker{% endif %}">
              <div class="tb-ticker" data-tb-ticker data-tb-ticker-interval="{{ section.settings.ticker_interval | default: 4 | times: 1000 }}">
                <p
                  class="tb-ticker-item is-active"
                  data-top-bar-shipping
                  data-prefix="{{ shipping_prefix | escape }}"
                  data-default-amount="{{ section.settings.tbtext_amount | default: 120 }}"
                  data-default-type="{{ section.settings.tbtext_default_type | default: 'discount' }}"
                  data-discount-prefix="{{ discount_prefix | escape }}"
                  data-default-discount-amount="{{ section.settings.tbtext_discount_amount | default: 5.9 }}"
                  data-default-currency="{{ localization.country.currency.iso_code | default: cart.currency.iso_code | default: shop.currency }}"
                >
                  {{ shipping_prefix }}
                </p>
                {%- if show_ticker -%}
                  <p class="tb-ticker-item">{{ section.settings.special_message_text }}</p>
                {%- endif -%}
              </div>
            </div>
            {% comment %} <div class="tb-lang-wrap">
                {% if localization.available_countries.size > 1 %}
                <div class="dropdown country-dropdown">
                    <button class="dropdown-trigger" type="button">
                    <span class="flag">
                        <img
                        src="https://flagcdn.com/w20/{{ localization.country.iso_code | downcase }}.png"
                        alt="{{ localization.country.name }}"
                        width="20"
                        height="14"
                        >
                    </span>
                    <span class="label">
                        {{ localization.country.name }}
                        ({{ localization.country.currency.iso_code }})
                    </span>
                    </button>

                    <ul class="dropdown-menu">
                    {% for country in localization.available_countries %}
                        <li>
                        <a href="{{ routes.root_url }}?country={{ country.iso_code }}">
                            <img
                            src="https://flagcdn.com/w20/{{ country.iso_code | downcase }}.png"
                            alt="{{ country.name }}"
                            width="20"
                            height="14"
                            >
                            <span>
                            {{ country.name }}
                            ({{ country.currency.iso_code }})
                            </span>
                        </a>
                        </li>
                    {% endfor %}
                    </ul>
                </div>
                {% endif %}

                {% if localization.available_languages.size > 1 %}
                {% assign lang_flags = 'en:gb,fr:fr,de:de' | split: ',' %}

                <div class="dropdown language-dropdown">
                    <button class="dropdown-trigger" type="button">
                    {% for map in lang_flags %}
                        {% assign pair = map | split: ':' %}
                        {% if pair[0] == localization.language.iso_code %}
                        <img
                            src="https://flagcdn.com/w20/{{ pair[1] }}.png"
                            alt="{{ localization.language.endonym_name | capitalize }}"
                            width="20"
                            height="14"
                        >
                        {% endif %}
                    {% endfor %}
                    <span class="label">
                        {{ localization.language.endonym_name | capitalize }}
                    </span>
                    </button>

                    <ul class="dropdown-menu">
                    {% for language in localization.available_languages %}
                        <li>
                        <a href="{{ language.root_url }}">
                            {% for map in lang_flags %}
                            {% assign pair = map | split: ':' %}
                            {% if pair[0] == language.iso_code %}
                                <img
                                src="https://flagcdn.com/w20/{{ pair[1] }}.png"
                                alt="{{ language.endonym_name | capitalize }}"
                                width="20"
                                height="14"
                                >
                            {% endif %}
                            {% endfor %}
                            <span>{{ language.endonym_name | capitalize }}</span>
                        </a>
                        </li>
                    {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div> {% endcomment %}
            <div class="tb-lang-wrap">
                <button class="locale-trigger" type="button" data-locale-open>
                    <img
                    src="https://flagcdn.com/w20/{{ localization.country.iso_code | downcase }}.png"
                    alt="{{ localization.country.name }}"
                    width="20"
                    height="14"
                    >
                    <span>
                    {{ localization.country.name }} |
                    {{ localization.language.iso_code | upcase }}
                    </span>
                </button>
            </div>

        </div>
    </div>
</div>

<div
  class="locale-modal"
  data-locale-modal
  data-current-country="{{ localization.country.iso_code }}"
  data-current-language="{{ localization.language.iso_code }}"
  data-lenis-prevent
>
  <div class="locale-backdrop" data-locale-close></div>

  <div class="locale-panel" data-lenis-prevent>
    <button class="locale-close" type="button" data-locale-close>×</button>

    <!-- COUNTRIES -->
    <div class="countries-select">
        {% if localization.available_countries.size > 1 %}
        <p class="selecthead">Select country</p>
        <ul class="locale-list">
            {% for country in localization.available_countries %}
            <li>
                <a href="#" data-country="{{ country.iso_code }}">
                <img
                    src="https://flagcdn.com/w20/{{ country.iso_code | downcase }}.png"
                    alt="{{ country.name }}"
                    width="20"
                    height="14"
                >
                <span>
                    {{ country.name }}
                    ({{ country.currency.iso_code }})
                </span>
                </a>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>

    <!-- LANGUAGES -->
    <div class="language-select">
        {% if localization.available_languages.size > 1 %}
        <p class="selecthead">Select language</p>
        <ul class="locale-list">
            {% for language in localization.available_languages %}
            <li>
                <a
                    href="#"
                    data-language="{{ language.iso_code }}"
                    data-language-url="{{ language.root_url }}"
                >
                <span class="lang-code">
                    {{ language.iso_code | upcase }}
                </span>
                <span>{{ language.endonym_name | capitalize }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>
    <div class="language-btn">
        <button class="locale-apply custom-btn filled rounded" type="button" data-locale-apply>Apply</button>
    </div>
  </div>
</div>

{% form 'localization', id: 'LocaleSwitchForm', class: 'visually-hidden' %}
  <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}" data-locale-country-input>
  <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" data-locale-language-input>
  <input type="hidden" name="return_to" value="{{ request.path }}" data-locale-return-input>
{% endform %}


{% comment %} <script>
document.addEventListener('click', function (e) {
  document.querySelectorAll('.dropdown').forEach(dropdown => {
    const button = dropdown.querySelector('.dropdown-trigger');

    if (button.contains(e.target)) {
      dropdown.classList.toggle('open');
    } else {
      dropdown.classList.remove('open');
    }
  });
});
</script> {% endcomment %}

<script>
(function () {
  const preferenceKey = 'jurassicLocalePreference';
  const dismissedKey = 'jurassicLocalePromptDismissed';

  function getLocaleModal() {
    return document.querySelector('[data-locale-modal]');
  }

  function setLocaleSelection(modal, country, language) {
    const selectedCountry = country || modal.dataset.currentCountry;
    const selectedLanguage = language || modal.dataset.currentLanguage;

    modal.dataset.selectedCountry = selectedCountry;
    modal.dataset.selectedLanguage = selectedLanguage;

    const languageEl = modal.querySelector(`[data-language="${selectedLanguage}"]`);
    if (languageEl) {
      modal.dataset.selectedLanguageUrl = languageEl.dataset.languageUrl;
    } else {
      delete modal.dataset.selectedLanguageUrl;
    }

    modal.querySelectorAll('[data-country]').forEach(el => {
      el.classList.toggle('is-selected', el.dataset.country === selectedCountry);
    });

    modal.querySelectorAll('[data-language]').forEach(el => {
      el.classList.toggle('is-selected', el.dataset.language === selectedLanguage);
    });
  }

  function getLanguageUrl(modal, languageCode) {
    const languageEl = modal.querySelector(`[data-language="${languageCode}"]`);
    return languageEl?.dataset.languageUrl || '';
  }

  function getRootPath(urlLike) {
    if (!urlLike) return '';

    try {
      const parsedUrl = new URL(urlLike, window.location.origin);
      const pathname = parsedUrl.pathname.replace(/\/+$/, '');
      return pathname === '/' ? '' : pathname;
    } catch (error) {
      return '';
    }
  }

  function stripLocalePrefix(pathname, modal) {
    const prefixes = Array.from(modal.querySelectorAll('[data-language-url]'))
      .map(el => getRootPath(el.dataset.languageUrl))
      .filter(Boolean)
      .sort((a, b) => b.length - a.length);

    for (const prefix of prefixes) {
      if (pathname === prefix) {
        return '/';
      }

      if (pathname.indexOf(`${prefix}/`) === 0) {
        return pathname.slice(prefix.length) || '/';
      }
    }

    return pathname || '/';
  }

  function buildLocalizedReturnPath(modal, languageCode) {
    const currentUrl = new URL(window.location.href);
    currentUrl.searchParams.delete('country');

    const targetRoot = getRootPath(getLanguageUrl(modal, languageCode));
    const basePath = stripLocalePrefix(currentUrl.pathname, modal);
    const localizedPath = `${targetRoot}${basePath === '/' ? '' : basePath}` || '/';

    return `${localizedPath}${currentUrl.search}${currentUrl.hash}`;
  }

  window.openLocaleModal = function (options = {}) {
    const modal = getLocaleModal();
    if (!modal) return;

    setLocaleSelection(
      modal,
      options.country || modal.dataset.currentCountry,
      options.language || modal.dataset.currentLanguage
    );
    modal.classList.add('is-open');
  };

  function closeLocaleModal(modal) {
    modal.classList.remove('is-open');
  }

  document.addEventListener('click', function (e) {
    const modal = getLocaleModal();
    if (!modal) return;

    /* ----------------------------
       OPEN MODAL
    ----------------------------- */
    if (e.target.closest('[data-locale-open]')) {
      window.openLocaleModal();
      return;
    }

    /* ----------------------------
       CLOSE MODAL
    ----------------------------- */
    if (e.target.closest('[data-locale-close]')) {
      if (modal.dataset.autoPrompt === 'true') {
        try {
          sessionStorage.setItem(dismissedKey, 'true');
        } catch (error) {}
        delete modal.dataset.autoPrompt;
      }
      closeLocaleModal(modal);
      return;
    }

    /* ----------------------------
       SELECT COUNTRY
    ----------------------------- */
    const countryEl = e.target.closest('[data-country]');
    if (countryEl) {
      e.preventDefault();
      modal.dataset.selectedCountry = countryEl.dataset.country;

      modal.querySelectorAll('[data-country]').forEach(el =>
        el.classList.remove('is-selected')
      );
      countryEl.classList.add('is-selected');
      return;
    }

    /* ----------------------------
       SELECT LANGUAGE
    ----------------------------- */
    const languageEl = e.target.closest('[data-language]');
    if (languageEl) {
      e.preventDefault();
      modal.dataset.selectedLanguage = languageEl.dataset.language;
      modal.dataset.selectedLanguageUrl = languageEl.dataset.languageUrl;

      modal.querySelectorAll('[data-language]').forEach(el =>
        el.classList.remove('is-selected')
      );
      languageEl.classList.add('is-selected');
      return;
    }

    /* ----------------------------
       APPLY
    ----------------------------- */
    if (e.target.closest('[data-locale-apply]')) {
      const country = modal.dataset.selectedCountry;
      const languageCode = modal.dataset.selectedLanguage;
      const localeForm = document.getElementById('LocaleSwitchForm');
      const countryInput = localeForm?.querySelector('[data-locale-country-input]');
      const languageInput = localeForm?.querySelector('[data-locale-language-input]');
      const returnInput = localeForm?.querySelector('[data-locale-return-input]');

      if (!localeForm || !countryInput || !languageInput || !returnInput) return;

      countryInput.value = country || modal.dataset.currentCountry;
      languageInput.value = languageCode || modal.dataset.currentLanguage;
      returnInput.value = buildLocalizedReturnPath(modal, languageInput.value);

      try {
        localStorage.setItem(preferenceKey, JSON.stringify({
          country: countryInput.value,
          language: languageInput.value,
          savedAt: Date.now()
        }));
      } catch (error) {}

      localeForm.submit();
    }
  });

  document.addEventListener('DOMContentLoaded', function () {
    const modal = getLocaleModal();
    if (!modal) return;

    const localeForm = document.getElementById('LocaleSwitchForm');
    const countryInput = localeForm?.querySelector('[data-locale-country-input]');
    const languageInput = localeForm?.querySelector('[data-locale-language-input]');
    const returnInput = localeForm?.querySelector('[data-locale-return-input]');
    const syncKey = 'jurassicLocalePreferenceSynced';

    try {
      const savedPreference = JSON.parse(localStorage.getItem(preferenceKey) || 'null');
      const savedCountry = (savedPreference?.country || '').toLowerCase();
      const savedLanguage = (savedPreference?.language || '').toLowerCase();
      const currentCountry = (modal.dataset.currentCountry || '').toLowerCase();
      const currentLanguage = (modal.dataset.currentLanguage || '').toLowerCase();
      const savedSignature = `${savedCountry}:${savedLanguage}`;

      if (
        savedCountry &&
        savedLanguage &&
        localeForm &&
        countryInput &&
        languageInput &&
        returnInput &&
        savedSignature !== sessionStorage.getItem(syncKey) &&
        (savedCountry !== currentCountry || savedLanguage !== currentLanguage)
      ) {
        countryInput.value = savedPreference.country;
        languageInput.value = savedPreference.language;
        returnInput.value = buildLocalizedReturnPath(modal, savedPreference.language);
        sessionStorage.setItem(syncKey, savedSignature);
        localeForm.submit();
        return;
      }
    } catch (error) {}

    const currentLanguage = (modal.dataset.currentLanguage || '').toLowerCase();
    const browserLanguage = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase().split('-')[0];
    if (!browserLanguage || browserLanguage === currentLanguage) return;

    const browserLanguageOption = modal.querySelector(`[data-language="${browserLanguage}"]`);
    if (!browserLanguageOption) return;

    try {
      const savedPreference = JSON.parse(localStorage.getItem(preferenceKey) || 'null');
      if (savedPreference?.language) return;
      if (sessionStorage.getItem(dismissedKey) === 'true') return;
    } catch (error) {}

    window.setTimeout(function () {
      modal.dataset.autoPrompt = 'true';
      window.openLocaleModal({
        country: modal.dataset.currentCountry,
        language: browserLanguage
      });
    }, 1000);
  });
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const topBarShipping = document.querySelector('[data-top-bar-shipping]');
  if (!topBarShipping) return;

  {%- comment -%}
    Two message types per market, editable from the theme editor (Market Threshold blocks)
    without touching code — see the Shipping Policy: most EU countries only get a shipping
    *discount* over the threshold, not free shipping outright. "type": "free" renders
    "{prefix} {amount}"; "type": "discount" renders "{discount_amount} {discount_prefix}
    {amount}" (e.g. "€5.90 shipping discount over €120"). Markets without a block fall back
    to data-default-type / data-default-amount / data-default-discount-amount below.
  {%- endcomment -%}
  const marketThresholds = {
    {% for block in section.blocks %}
      {% if block.type == 'market_threshold' and block.settings.market_code != blank and block.settings.amount != blank %}
        "{{ block.settings.market_code | downcase | strip }}": {
          type: {{ block.settings.message_type | default: 'free' | json }},
          amount: {{ block.settings.amount | json }},
          discountAmount: {{ block.settings.discount_amount | json }}
        },
      {% endif %}
    {% endfor %}
  };

  function resolveMarketKey() {
    const urlParams = new URLSearchParams(window.location.search);
    let market = window.corner?.sessionData?.market || urlParams.get('country') || '{{ localization.country.iso_code }}';
    let marketKey = String(market || '').toLowerCase().trim();

    const countryMap = {
      france: 'fr',
      germany: 'de',
      austria: 'at',
      'united kingdom': 'gb',
      'united states': 'us',
      india: 'in'
    };

    if (countryMap[marketKey]) {
      marketKey = countryMap[marketKey];
    }

    return marketKey;
  }

  function formatThreshold(amount, minimumFractionDigits) {
    const currencyCode =
      window.activeCurrency ||
      topBarShipping.dataset.defaultCurrency ||
      '{{ shop.currency }}';

    const numericAmount = Number(amount);
    if (Number.isNaN(numericAmount)) {
      return amount;
    }

    return new Intl.NumberFormat(document.documentElement.lang || undefined, {
      style: 'currency',
      currency: currencyCode,
      minimumFractionDigits: minimumFractionDigits ?? 0,
      maximumFractionDigits: 2
    }).format(numericAmount);
  }

  function updateTopBarShipping() {
    const marketKey = resolveMarketKey();
    const market = marketThresholds[marketKey];

    const type = market?.type || topBarShipping.dataset.defaultType || 'free';
    const amount = market?.amount ?? topBarShipping.dataset.defaultAmount;

    if (type === 'discount') {
      const discountPrefix = topBarShipping.dataset.discountPrefix || 'shipping discount over';
      const discountAmount = market?.discountAmount ?? topBarShipping.dataset.defaultDiscountAmount;
      // Discount amounts (e.g. 5.90) always show 2 decimals; round thresholds don't need them.
      topBarShipping.textContent = `${formatThreshold(discountAmount, 2)} ${discountPrefix} ${formatThreshold(amount)}`;
    } else {
      const prefix = topBarShipping.dataset.prefix || 'Free shipping on orders above';
      topBarShipping.textContent = `${prefix} ${formatThreshold(amount)}`;
    }
  }

  updateTopBarShipping();

  let attempts = 0;
  const retryTimer = window.setInterval(() => {
    attempts += 1;
    updateTopBarShipping();

    if (window.corner?.sessionData?.market || attempts >= 5) {
      window.clearInterval(retryTimer);
    }
  }, 700);

  // Special-occasion ticker: only present in the DOM when a special message is enabled
  // in the section settings and non-empty (see the show_ticker check in the markup above),
  // so this is a no-op the rest of the time.
  const ticker = document.querySelector('[data-tb-ticker]');
  const tickerItems = ticker ? ticker.querySelectorAll('.tb-ticker-item') : [];
  if (ticker && tickerItems.length > 1) {
    let activeIndex = 0;
    const intervalMs = parseInt(ticker.dataset.tbTickerInterval, 10) || 4000;

    window.setInterval(() => {
      tickerItems[activeIndex].classList.remove('is-active');
      activeIndex = (activeIndex + 1) % tickerItems.length;
      tickerItems[activeIndex].classList.add('is-active');
    }, intervalMs);
  }
});
</script>









{% schema %}
  {
    "name": "top-bar",
    "tag": "section",
    "settings": [
        {
            "type": "image_picker",
            "id": "rating_image",
            "label": "Rating Image"
        },
        {
            "type": "text",
            "id": "rating_text",
            "label": "Rating Text"
        },
        {
            "type": "text",
            "id": "tbtext_prefix",
            "label": "Free Shipping Prefix (override)",
            "info": "Leave blank to use the translated text from locales/*.json (recommended — it auto-adapts per store language). Only set this if you want the exact same text on every language."
        },
        {
            "type": "number",
            "id": "tbtext_amount",
            "label": "Default Threshold Amount",
            "info": "Used for any country without its own Market Threshold block below.",
            "default": 120
        },
        {
            "type": "select",
            "id": "tbtext_default_type",
            "label": "Default Message Type",
            "info": "Message shown for countries without their own Market Threshold block — per the Shipping Policy, most countries get a discount rather than free shipping.",
            "options": [
                { "value": "free", "label": "Free shipping" },
                { "value": "discount", "label": "Shipping discount" }
            ],
            "default": "discount"
        },
        {
            "type": "text",
            "id": "tbtext_discount_prefix",
            "label": "Shipping Discount Text (override)",
            "info": "e.g. \"€5.90 [this text] €120\". Leave blank to use the translated text from locales/*.json (recommended)."
        },
        {
            "type": "number",
            "id": "tbtext_discount_amount",
            "label": "Default Discount Amount",
            "info": "Used for any country without its own Market Threshold block below.",
            "default": 5.9
        },
        {
            "type": "header",
            "content": "Special Occasion Message"
        },
        {
            "type": "checkbox",
            "id": "special_message_enabled",
            "label": "Enable special occasion message",
            "info": "When on, this message and the shipping message auto-rotate as a ticker. When off, only the shipping message shows (no ticker).",
            "default": false
        },
        {
            "type": "text",
            "id": "special_message_text",
            "label": "Special Occasion Message",
            "info": "e.g. \"🎄 Christmas orders ship until Dec 20\""
        },
        {
            "type": "range",
            "id": "ticker_interval",
            "label": "Ticker Rotation Speed (seconds)",
            "min": 2,
            "max": 10,
            "step": 1,
            "default": 4
        }

    ],
    "blocks": [
        {
            "type": "market_threshold",
            "name": "Market Threshold",
            "settings": [
                {
                    "type": "text",
                    "id": "market_code",
                    "label": "Country / Market Code",
                    "info": "Use country codes like DE, IN, US, FR, GB"
                },
                {
                    "type": "select",
                    "id": "message_type",
                    "label": "Message Type",
                    "options": [
                        { "value": "free", "label": "Free shipping" },
                        { "value": "discount", "label": "Shipping discount" }
                    ],
                    "default": "free"
                },
                {
                    "type": "number",
                    "id": "amount",
                    "label": "Threshold Amount"
                },
                {
                    "type": "number",
                    "id": "discount_amount",
                    "label": "Discount Amount",
                    "info": "Only used when Message Type is \"Shipping discount\", e.g. 5.90"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "top-bar",
            "settings": {
            }
        }
    ]
  }
{% endschema %}
